# Copia este archivo a .env y establece valores propios.
POSTGRES_USER=postgres
POSTGRES_DB=chatbot_db
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/chatbot_db
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
OPENROUTER_API_KEY=replace-with-your-provider-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small
API_BASE_URL=http://localhost:8000
UI_TIMEZONE=America/Argentina/Buenos_Aires
# Sin WORKSPACE_ROOT se usa la carpeta personal del usuario que ejecuta la API.
# WORKSPACE_ROOT=/home/usuario
# En Windows: WORKSPACE_ROOT=C:/Users/usuario
WORKSPACE_SCOPE=shared
WORKSPACE_RULES_FILE=workspace_rules.json
# Docker detecta HOME en Linux o USERPROFILE en Windows. Puedes elegir otra ruta:
# WORKSPACE_HOST_ROOT=/home/usuario
# En Linux configura estos valores con id -u e id -g:
# WORKSPACE_UID=1000
# WORKSPACE_GID=1000
MAX_FILE_BYTES=100000
DB_POOL_SIZE=10
AGENT_MAX_STEPS=6
AGENT_MAX_SECONDS=120
AGENT_CONTEXT_TOKENS=16000
AGENT_OUTPUT_TOKENS=2000
MODEL_TIMEOUT_SECONDS=30
API_TIMEOUT_SECONDS=150
MEMORY_MIN_SIMILARITY=0.65
LOGIN_ATTEMPTS_PER_MINUTE=10
